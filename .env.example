# Copy this file to .env.local and fill in when you have a real API key.
# Until then, leave USE_MOCK_AI=true and the app runs entirely on simulated
# AI responses (see lib/ai/mockAI.js) so every screen still works end-to-end.

USE_MOCK_AI=true
ANTHROPIC_API_KEY=

# Model to use once USE_MOCK_AI=false. Sonnet is a good default for
# vision + text analysis at reasonable cost.
ANTHROPIC_MODEL=claude-sonnet-4-5
